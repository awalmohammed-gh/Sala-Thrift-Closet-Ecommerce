{
  "id": "/",
  "name": "SALASTY THRIFT CLOSET",
  "short_name": "SALASTY",
  "description": "Thrift clothing store with WhatsApp checkout",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.json"
    }
  ],
  "prefer_related_applications": false,
  "orientation": "any",
  "background_color": "#FAF8F3",
  "theme_color": "#2563EB",
  "icons": [
    {
      "src": "/icons/store-apple-icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/store-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/store-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/store-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/store-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop All",
      "short_name": "Shop",
      "description": "Browse all products and collections",
      "url": "/products",
      "icons": [
        {
          "src": "/icons/store-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Cart",
      "short_name": "Cart",
      "description": "View your shopping cart",
      "url": "/cart",
      "icons": [
        {
          "src": "/icons/store-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Orders",
      "short_name": "Orders",
      "description": "View your past orders and tracking",
      "url": "/my-orders",
      "icons": [
        {
          "src": "/icons/store-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
